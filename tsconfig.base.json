{
  "compilerOptions": {
    "baseUrl": ".",
    "rootDir": "src",
    "target": "ES2022",
    "lib": ["ES2022"],
    "esModuleInterop": true,
    "sourceMap": true,
    "moduleResolution": "node",
    "declaration": true,
    "removeComments": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitReturns": true,
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true
  }
}
