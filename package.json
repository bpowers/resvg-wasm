{
  "name": "resvg-wasm",
  "version": "0.5.0",
  "description": "SVG renderer using resvg as a WebAssembly module",
  "repository": "https://github.com/bpowers/resvg-wasm",
  "author": {
    "name": "Bobby Powers",
    "email": "bobbypowers@gmail.com"
  },
  "license": "MPL-2.0",
  "main": "lib",
  "browser": "lib.browser",
  "exports": {
    ".": {
      "workerd": "./lib.workerd/index.js",
      "module": "./lib.browser/index.js",
      "node": "./lib/index.js"
    },
    "./*": {
      "workerd": "./lib.workerd/*.js",
      "module": "./lib.browser/*.js",
      "node": "./lib/*.js"
    },
    "./core/*": {
      "workerd": "./lib.workerd/core/*.js",
      "module": "./lib.browser/core/*.js",
      "node": "./lib/core/*.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.0",
    "prettier": "^3.8.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.55.0"
  },
  "scripts": {
    "needs-format": "prettier -l '*.ts'",
    "format": "prettier --write '*.ts'",
    "lint": "eslint '*.ts'",
    "prepublishOnly": "pnpm build",
    "clean": "rm -rf ./lib ./lib.browser ./lib.workerd",
    "build": "./build.sh"
  }
}
